# Overview of every environment variable in this repo. Nothing loads a .env file
# from the repo root, so copy each block to the file named above it.
# Everything is optional for starting the apps: Supabase code fails with a clear
# error only when it is used.

# ---- apps/web/.env.local (template: apps/web/.env.example) ----

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend (pnpm dev:api).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Set to live for the presenter's build only: the flights page starts in Live and runs only a flight someone picks. Leave unset otherwise.
NEXT_PUBLIC_DEFAULT_RUN_MODE=

# ---- apps/api/.env (template: apps/api/.env.example) ----

# Supabase project URL, the same value as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=http://127.0.0.1:54321

# Server-only secret key (sb_secret_...). Bypasses row level security, so never
# expose it to the browser or give it a NEXT_PUBLIC_ prefix.
SUPABASE_SECRET_KEY=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Set to 1 to allow live model runs, which spend money. Anything else refuses them.
ALLOW_LIVE=

# Anthropic API key for live model runs. Secret: never commit it or print it.
# Read from the process environment, so load this file into the shell (below).
ANTHROPIC_API_KEY=

# FLIGHTS_CSV points at the DOT flights.csv. It is read from the process
# environment only, not this file. Unset uses data/flight-delays/flights.csv.

# ---- Launch with the model on ----
#
# From the repo root, in two terminal tabs. In a worktree, apps/api/.env is not
# there, so use the full path to the main checkout's copy. One flight picked in
# Live makes up to 6 model calls. Without these steps Live is refused.
#
# Tab 1, the API. This does not print the key:
#   set -a; . apps/api/.env; set +a; ALLOW_LIVE=1 uv --directory apps/api run uvicorn app.main:app --port 8000
#
# Tab 2, the dashboard, built to start in Live:
#   NEXT_PUBLIC_DEFAULT_RUN_MODE=live pnpm --filter web build && pnpm --filter web start
#
# Then open http://localhost:3000/dashboard/flights and pick a flight.
# If a run has not returned after 40 seconds or shows faults, click Recorded.
