# Copy to .env (git-ignored) and fill in. The app starts with none of these set;
# SUPABASE_* are only needed once something asks for the Supabase client.

# Local stack: run `supabase start` at the repo root and use the API URL it prints.
SUPABASE_URL=http://127.0.0.1:54321

# Server-only secret key (sb_secret_...). Never expose it to the browser.
# Local stack: copy the secret key from `supabase status`.
SUPABASE_SECRET_KEY=

# Comma-separated browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000

# Set to 1 to allow live model runs, which spend money. Anything else refuses them.
ALLOW_LIVE=

# Anthropic API key for live model runs. Secret: never commit it or print it.
# Read from the process environment, so load this file into the shell (below).
ANTHROPIC_API_KEY=

# FLIGHTS_CSV points at the DOT flights.csv. It is read from the process
# environment only, not this file. Unset uses data/flight-delays/flights.csv.

# Launch with the model on, from the repo root. This does not print the key:
#   set -a; . apps/api/.env; set +a; ALLOW_LIVE=1 uv --directory apps/api run uvicorn app.main:app --port 8000
# Or, reloading on code changes, so not for the talk: ALLOW_LIVE=1 pnpm dev:api:live
# The dashboard's start command is in apps/web/.env.example.
