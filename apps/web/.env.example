# Copy to .env.local and fill in. All values are optional: the app starts and
# renders without them, and Supabase code throws a clear error only when used.

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend (apps/api, pnpm dev:api).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to live for the presenter's build only: the flights page starts in Live and
# runs only a flight someone picks. Leave unset otherwise. Read at build time.
NEXT_PUBLIC_DEFAULT_RUN_MODE=

# Launch with the model on, from the repo root, after starting the API as in
# apps/api/.env.example:
#   NEXT_PUBLIC_DEFAULT_RUN_MODE=live pnpm --filter web build && pnpm --filter web start
# Then open http://localhost:3000/dashboard/flights and pick a flight.
