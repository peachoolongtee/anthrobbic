# Copy to .env.local and fill in. All values are optional: the app starts and
# renders without them, and Supabase code throws a clear error only when used.

# Supabase project URL (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend (apps/api, pnpm dev:api).
NEXT_PUBLIC_API_URL=http://localhost:8000
